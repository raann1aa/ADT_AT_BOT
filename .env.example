# Environment configuration for WhatsApp Farmer AI Bot

# Google Gemini API Key (Required for Phase B - LLM Generation)
# Get your key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Meta WhatsApp Cloud API (Required for WhatsApp integration)
WHATSAPP_TOKEN=your_meta_system_user_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_secret_verify_token

# Google Sheets / Form Automation (Phase 4)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/google_service_account.json
FARMER_RESPONSES_SPREADSHEET_ID=your_google_sheet_id_here
